0, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Let's give suggestions! A friend from another city is in your city. Make some suggestions about what to visit."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Getting Lost"}, {"type": "unit_name", "content": "Should We Ask for Help?"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 9}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe places, neighborhoods and countries in communicative situations."}, {"type": "secondary_1", "content": " Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": " Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_4", "content": " Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_7", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_8", "content": " Understands key information in written texts about the communicative topics related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Modal Should for Suggestions"}, {"type": "describer", "content": "You use the modal verb should to offer suggestions."}, {"type": "example", "content": "He should see the exhibition in Boston. "}, {"type": "text", "content": "The form is:<br /> subject + modal verb + main verb<br />We&nbsp &nbsp&nbsp&nbsp &nbsp  &nbsp &nbsp   should  &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp  visit &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp the art gallery! "}, {"type": "example", "content": "They should go to the harbor area for lunch. "}, {"type": "example", "content": "You should ask for directions."}, {"type": "text", "content": "There is only one form of should. It does not change."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Asking and Saying Where Places Are"}, {"type": "describer", "content": " You use the Simple Present tense to ask and say where places are. "}, {"type": "text", "content": "When you ask where a place is you say:<br/><span class=\"italic\">Where is _____ ? <br/>Is ______ near here?<br/> What street is _____ on?</span>"}, {"type": "text", "content": "To say where a place is, you use prepositions and directions. <br/> _____ <span class=\"italic\"> is on ______ Street. <br/>It's south on  ______ Street.</span>"}, {"type": "text", "content": "When you do not know where a place is you say:<br/><span class=\"italic\"> I'm sorry, I don't know.<br/>I'm sorry, I have no idea.</span>"}, {"type": "text", "content": "Cultural Tip <br/>Saying<span class=\"italic\"> \"I have no idea.\" </span>without<span class=\"italic\"> \"I'm sorry,\"</span> is not very polite."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Response</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Where is Exhibition Place?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">It's by the harbor.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Is  Exhibition Place near here?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Yes. It's south on Liberty Street.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What street is  Exhibition Place on?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'm sorry, I have no idea.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "city hall "}, {"type": "definition", "content": "the building for a city government "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The new city hall is on the next street."}, {"type": "audio", "content": "engenn2le09ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about places in a city."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "art gallery "}, {"type": "definition", "content": "a building to show paintings and sculpture "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The art gallery is showing paintings by Picasso."}, {"type": "audio", "content": "engenn2le09ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gas station"}, {"type": "definition", "content": "a place to buy gasoline and oil"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's stop at the gas station. We need gas!"}, {"type": "audio", "content": "engenn2le09ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "convenience store "}, {"type": "definition", "content": "a store in a busy area, open late, with everyday items to buy "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's stop at the convenience store. I need to buy milk."}, {"type": "audio", "content": "engenn2le09ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "across "}, {"type": "definition", "content": "on the other side of "}, {"type": "part_speech", "content": "(preposition)"}, {"type": "example", "content": "Example: The art gallery is across the street."}, {"type": "audio", "content": "engenn2le09ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "attendant "}, {"type": "definition", "content": "a person who helps in a place like a gas station "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The gas station attendant fills your car with fuel. "}, {"type": "audio", "content": "engenn2le09ob02aud06"}]}, {"type": "background_image", "content": "engenn2le09ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Suggest two or three places to go to for a friend visiting your city."}, {"type": "text", "content": " Say where the places are."}, {"type": "text", "content": "Give the street names."}, {"type": "text", "content": "Choose one place."}, {"type": "text", "content": "Say how your friend should go there (walk, go by taxi, go by bus)."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I make suggestions about places to go."}, {"type": "text", "content": "I give directions to places."}, {"type": "text", "content": "I talk about how people can get to places."}]}], "type": "sena"}