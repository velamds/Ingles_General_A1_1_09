{"_data": [{"type": "metadata", "contents": [{"content": "Getting Lost", "type": "lesson_name"}, {"content": "You Are Going the Wrong Way!", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 9, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe places, neighborhoods and countries in communicative situations.", "type": "primary"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_3"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_4"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_7"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " The Imperative to Give Directions", "type": "heading"}, {"content": "Use the Imperative to give a person directions and to repeat them. You do not use the subject, so the verb is stressed. ", "type": "describer"}, {"content": "Walk down this street to Exhibition Place.", "type": "example"}, {"content": "Go back along this street to the intersection.", "type": "example"}, {"content": "Turn right at the corner.", "type": "example"}, {"content": "Verb (+ Preposition) + Object", "type": "text"}, {"content": "Walk down the street.", "type": "text"}, {"content": "Go straight down the hall.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Giving Directions", "type": "heading"}, {"content": " You use a preposition or an expression when you give directions.", "type": "describer"}, {"content": "Walk along Liberty street to the intersection.", "type": "example"}, {"content": "The park is at the intersection of Main and Liberty.", "type": "example"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Expression</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Preposition </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">straight ahead<br /> go back along<br /> the wrong way<br /> turn right</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">to</span> the intersection<br /><span class=\\\"strong\\\">at</span>  the intersection<br /><span class=\\\"strong\\\"> along</span>  the street\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": " not a bad idea ", "type": "name"}, {"content": " it's a good plan or thought ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Go to the film festival? That's not a bad idea!", "type": "example"}, {"content": "engenn2le09ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you look for a place.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "I guess so ", "type": "name"}, {"content": "maybe; I'm not sure  ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Do you think this is the right direction? I guess so.", "type": "example"}, {"content": "engenn2le09ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "wrong way ", "type": "name"}, {"content": "not the correct direction ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We are going the wrong way. The store is in the opposite direction.", "type": "example"}, {"content": "engenn2le09ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bank ", "type": "name"}, {"content": "the building where you put your money", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Let's go to the bank and get some cash for our trip.", "type": "example"}, {"content": "engenn2le09ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "police officer ", "type": "name"}, {"content": "a person who enforces the law", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Police officers help stop crime.", "type": "example"}, {"content": "engenn2le09ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "you can't miss it ", "type": "name"}, {"content": "it is easy to see  ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: The park is on this street. You can't miss it!", "type": "example"}, {"content": "engenn2le09ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "intersection ", "type": "name"}, {"content": " the place where two streets meet ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Meet me at the intersection of Main and Front streets.", "type": "example"}, {"content": "engenn2le09ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to have to ", "type": "name"}, {"content": " to be necessary ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We have to leave before 10 p.m.", "type": "example"}, {"content": "engenn2le09ob03aud08", "type": "audio"}]}, {"content": "engenn2le09ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "The person asks you about a place in your area.", "type": "text"}, {"content": "You say they are not going in the right direction.", "type": "text"}, {"content": "Tell them where to go.", "type": "text"}, {"content": "Say street names and use prepositions to help the person find their way.", "type": "text"}, {"content": "Practice your dialogue.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use the Imperative to give directions.", "type": "text"}, {"content": "I use street names.", "type": "text"}, {"content": "I say where places are.", "type": "text"}, {"content": "I practice my dialogue with a partner.", "type": "text"}]}], "labs": [{"stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "_data": [], "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le09ob03re2aud01", "images": [{"image": "engenn2le09ob03re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le09ob03re2img05.jpg", "id": 1, "text": "<span class=\"strong prelo-dialogue-100\">Sally</span>:      See John, asking for help isn't a bad idea.<br />\n<span class=\"strong\">John</span>:      I guess so. I don't see Exhibition Place.", "time": "10"}, {"image": "engenn2le09ob03re2img05.jpg", "id": 2, "text": "<span class=\"strong prelo-dialogue-100\">Sally</span>:      Sure this is it!<br />\n<span class=\"strong\">John</span>:      No, this says Convention Place.", "time": "8000"}, {"image": "engenn2le09ob03re2img06.jpg", "id": 3, "text": "<span class=\"strong prelo-dialogue-100\">Sally</span>:      Oh! Turn here!<br />\n<span class=\"strong\">John</span>:      No, go this way!", "time": "13000"}, {"image": "engenn2le09ob03re2img01.jpg", "id": 4, "text": "<span class=\"strong prelo-dialogue-100\">Sally</span>:      Ask the police officer.<br />\n<span class=\"strong\">John</span>:      Alright. Excuse me officer, we are very lost.", "time": "17000"}, {"image": "engenn2le09ob03re2img01.jpg", "id": 5, "text": "<span class=\"strong prelo-dialogue-100\">Police Officer</span>:      How can I help?<br />\n<span class=\"strong\">John</span>:      We're looking for the country fair at Exhibition Place.", "time": "24000"}, {"image": "engenn2le09ob03re2img01.jpg", "id": 6, "text": "<span class=\"strong prelo-dialogue-100\">Police Officer</span>:      You're walking the wrong way.<br />\n<span class=\"strong\">John</span>:      Again!", "time": "29000"}, {"image": "engenn2le09ob03re2img01.jpg", "id": 7, "text": "<span class=\"strong prelo-dialogue-100\">Police Officer</span>:      You have to go back along this street. There is a bank at the intersection.\nTurn right. Walk straight ahead. You can't miss it!<br />\n<span class=\"strong\">John</span>:      Thank you.", "time": "32000"}, {"image": "engenn2le09ob03re2img01.jpg", "id": 8, "text": "<span class=\"strong prelo-dialogue-100\">Sally</span>:      Look! It's there!<br />\n<span class=\"strong\">John</span>:      Finally!", "time": "43500"}], "coverimg": "engenn2le09ob03re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "img_path": "", "type": "WLC", "_data": [{"type": "instructions", "contents": [{"content": "I can give directions.", "type": "Learning Outcomes"}, {"content": "I can talk about places and attractions in a city.", "type": "Learning Outcomes"}, {"content": "Who do you ask for help when yo