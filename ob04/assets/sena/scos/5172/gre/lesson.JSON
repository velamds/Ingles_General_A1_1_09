nt": "engenn2le09ob04img03.jpg"}, {"type": "text", "content": "Clay"}, {"type": "image", "content": "engenn2le09ob04img01.jpg "}, {"type": "text", "content": "Wood"}, {"type": "image", "content": "engenn2le09ob04img02.jpg"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "architecture "}, {"type": "definition", "content": "the style of a building"}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: The classic architecture is stunning!"}, {"type": "audio", "content": "engenn2le09ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about places in a town."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "display "}, {"type": "definition", "content": "to show something in an organized way "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: The flower displays are so colorful - red, purple, green and blue."}, {"type": "audio", "content": "engenn2le09ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "florist"}, {"type": "definition", "content": "a business or a person that sells flowers "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: The florist shop beside the CBR bank is open."}, {"type": "audio", "content": "engenn2le09ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "classic  "}, {"type": "definition", "content": "traditional  "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The classic architecture is stunning!"}, {"type": "audio", "content": "engenn2le09ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "location "}, {"type": "definition", "content": "where something is "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: That is a great location for a shop!"}, {"type": "audio", "content": "engenn2le09ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ceiling "}, {"type": "definition", "content": "the top of the room "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The high ceilings, the big windows and the color ... ! Pink!"}, {"type": "audio", "content": "engenn2le09ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "dozen "}, {"type": "definition", "content": "12 of something "}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example: How about we get her a dozen yellow roses?"}, {"type": "audio", "content": "engenn2le09ob04aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "database "}, {"type": "definition", "content": "a place to store information "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: Could I have your email address for our database? "}, {"type": "audio", "content": "engenn2le09ob04aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "vase  "}, {"type": "definition", "content": "a container to hold flowers "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Please pass me a vase for the flowers."}, {"type": "audio", "content": "engenn2le09ob04aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "glass "}, {"type": "definition", "content": "material you use in windows "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: The glass vase is expensive."}, {"type": "audio", "content": "engenn2le09ob04aud10"}]}, {"type": "background_image", "content": "engenn2le09ob04re1img01.png"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Long A Sound"}, {"type": "describer", "content": "The most common long a sounds come from <span class = \"italic\">a-e</span>, <spa