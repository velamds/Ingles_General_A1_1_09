{"_data": [{"type": "metadata", "contents": [{"content": "Getting Lost", "type": "lesson_name"}, {"content": "It's Very Easy", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 9, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe places, neighborhoods and countries in communicative situations. ", "type": "primary"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.   Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.   Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.   Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.   Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Descriptive writing", "type": "heading"}, {"content": "A descriptive paragraph describes a thing, a person, or a place.<br/> Detailed information lets the reader make an image in his or her mind. <br/>There are three parts to a paragraph.", "type": "describer"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Topic Sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Introduces the main idea/point that you want to develop\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Supporting Sentences\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" To add to and provide examples of the main point \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Concluding Sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Finishes off the paragraph\\\"}\"],\"styles\":\"\"}", "type": "table"}, {"content": "You use adjectives and adverbs to add detail and description in your writing. This allows the reader to imagine what you are writing about.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "run-down", "type": "name"}, {"content": "not cared for, old, too much use", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The painting shows an old, run down shack in Columbus, Ohio. ", "type": "example"}, {"content": "engenn2le09ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you talk about artwork.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "shack", "type": "name"}, {"content": "an old damaged house", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The run down shack was abandoned.", "type": "example"}, {"content": "engenn2le09ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "broken", "type": "name"}, {"content": "damaged", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The farmhouse has broken windows and no door. ", "type": "example"}, {"content": "engenn2le09ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "drought", "type": "name"}, {"content": "a long time without rain", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The family left the farm after a drought in 1930.", "type": "example"}, {"content": "engenn2le09ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "edge of town", "type": "name"}, {"content": "far from the center of a town", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: The gray house is sitting on the edge of town. ", "type": "example"}, {"content": "engenn2le09ob08aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "plaque", "type": "name"}, {"content": "a square with a description of a painting", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Did you see the plaque under the painting?", "type": "example"}, {"content": "engenn2le09ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "powerful", "type": "name"}, {"content": "strong, important", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Nicholson's painting is a powerful picture of these times.", "type": "example"}, {"content": "engenn2le09ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "porch", "type": "name"}, {"content": "part of the front of a house you can stand on", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There is no porch on the front of the house. ", "type": "example"}, {"content": "engenn2le09ob08aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "abandoned", "type": "name"}, {"content": "empty", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It is abandoned.", "type": "example"}, {"content": "engenn2le09ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "upstairs", "type": "name"}, {"content": "on the second floor", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Sally: John, let's stop at this art exhibit upstairs.", "type": "example"}, {"content": "engenn2le09ob08aud10", "type": "audio"}]}, {"content": "engenn2le09ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose something that you own.", "type": "text"}, {"content": "Write a descriptive paragraph. Use the paragraph structure below.", "type": "text"}, {"content": "What does it look like? What does it do?", "type": "text"}, {"content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Paragraph structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"1. Opening sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2. Supporting sentences\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3. Concluding sentence\\\"}\"],\"styles\":\" instruction_table_background\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about something I own in complete statements.", "type": "text"}, {"content": "I use action words that talk about the present.", "type": "text"}, {"content": "I use the correct paragraph structure.", "type": "text"}]}], "labs": [{"stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "_data": [], "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le09ob08re2aud01", "images": [{"image": "engenn2le09ob08re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le09ob08re2img05.jpg", "id": 1, "text": "<span class = \"strong\">Sally</span>: John, let's stop at this art exhibit upstairs. Wow, look at these paintings!<br/>\n<span class = \"strong\">John</span>: Yeah, there is a lot of amazing artwork here. This mall is incredible.", "time": "10"}, {"image": "engenn2le09ob08re2img02.jpg", "id": 2, "text": "<span class = \"strong\">Sally</span>: I know. There are so many great attractions in Boston. The new stadium and City Hall are on my list to visit  too.<br/>\n<span class = \"strong\">John</span>: I'm just so busy these days. It's nice that we can do something together today.<br/>\n<span class = \"strong\">Sally</span>: Oh, I wish I could paint ... I love this one. Who is the painter?", "time": "12750"}, {"image": "engenn2le09ob08re2img01.jpg", "id": 3, "text": "<span class = \"strong\">John</span>: Some people find painting easy ... not me. Charles G. Nicholson - he's an American painter.<br/>\n<span class = \"strong\">Sally</span>: Doesn't he paint about American history and culture?<br/>\n<span class = \"strong\">John</span>: Look at the plaque at the bottom of the painting. Can you read it?<br/>", "time": "33250"}], "coverimg": "engenn2le09ob08re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "", "time": "0"}, {"image": "", "id": 1, "text": "<span class = \"bullet\">A descriptive paragraph</span>", "time": "5000"}, {"image": "", "id": 2, "text": "<span class = \"bullet\">What do you include in a descriptive paragraph?</span>", "time": "17000"}], "video_src": "engenn2le09ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "img_path": "", "type": "WLC", "_data": [{"type": "in