e": "lesson", "content": 9}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe places, neighborhoods and countries in communicative situations."}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_4", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Talking About Things That Are Probable"}, {"type": "describer", "content": "You can use the modal <span class=\"italic\">should</span> to talk about things that are probable.<br/>When something is probable, it may happen or it may not happen."}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Statement\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">It should be around here.<br/> It should be on the right.<br/></span><span class = \\\"italic\\\">The mall should be open today.<span/><br/><span class = \\\"italic\\\">The map should be on the first floor.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">It is probably around here.<br/>It is likely there.</span><br/><span class = \\\"italic\\\">I'm quite sure the mall is open today.<br/><span class = \\\"italic\\\">The map is almost certainly on the first floor.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "The shop should be on the right."}, {"type": "example", "content": "The mall map should be around here."}, {"type": "example", "content": "It should be upstairs."}, {"type": "example", "content": "It should be on the upper floor."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "upper"}, {"type": "definition", "content": "higher; above here"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: That store is on the upper floor."}, {"type": "audio", "content": "engenn2le09ob09aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about a shopping center."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "floor"}, {"type": "definition", "content": "a level in a building"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The coffee shop is on the 2nd floor."}, {"type": "audio", "content": "engenn2le09ob09aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to get off"}, {"type": "definition", "content": " leave a bus or train"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Get off the bus at the next stop."}, {"type": "audio", "content": "engenn2le09ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "first"}, {"type": "definition", "content": "before other things"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I want to shop for shoes first."}, {"type": "audio", "content": "engenn2le09ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hall"}, {"type": "definition", "content": "a long space between rooms in buildings"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Go down the hall and turn right. The coffee shop is there."}, {"type": "audio", "content": "engenn2le09ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "metal"}, {"type": "definition", "content": "a material like gold, silver or iron"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The shopping center has large metal doors. "}, {"type": "audio", "content": "engenn2le09ob09aud06"}]}, {"type": "background_image", "content": "engenn2le09ob09re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find a mall map in a mall or online. "}, {"type": "text", "content": "Choose two stores in different areas or on different levels."}, {"type": "text", "content": "Write how to get to the store from the entrance."}, {"type": "text", "content": "Use <span class=\"italic\">should</span> to show something is probable."}, {"type": "text", "content": "Use prepositions."}, {"type": "text", "content": "Write 20 to 30 words."}, {"type": "text", "content": "Read your directions to a friend."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about possibility."}, {"type": "text", "content": "I talk about location."}, {"type": "text", "content": "I write 20 to 30 words about two stores."}, {"type": "text", "content": "I read my directions aloud."}]}], "type": "sena"}